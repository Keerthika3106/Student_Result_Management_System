<VBox alignment="CENTER" spacing="10">
    <Label text="Student Result Management System"/>
    <GridPane>
        <Label text="Student ID:"/><TextField fx:id="txtId"/>
        <Label text="Name:"/><TextField fx:id="txtName"/>
        <Label text="Subject:"/><TextField fx:id="txtSubject"/>
        <Label text="Marks:"/><TextField fx:id="txtMarks"/>
    </GridPane>
    <HBox alignment="CENTER" spacing="10">
        <Button text="Add Result" onAction="#handleAddResult"/>
        <Button text="Load Results" onAction="#handleLoadResults"/>
    </HBox>
</VBox> 
